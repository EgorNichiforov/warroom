# ---------- THINKSPACE configuration ----------
# Copy to .env.local (never commit real values).

# Database. Leave empty to use the embedded PGlite Postgres under .data/pglite (local dev, tests).
# For production use a Postgres connection string (e.g. Supabase, "Transaction" pooler URL).
DATABASE_URL=
THINKSPACE_PGLITE_DIR=.data/pglite
# All tables live in the "thinkspace" schema (created automatically), so a shared Postgres host is safe.
# DATABASE_URL may contain the placeholder __PASSWORD__, filled from DATABASE_PASSWORD:
#   DATABASE_URL=postgresql://postgres.<project-ref>:__PASSWORD__@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=

# Access control. Set both for any deployment that is reachable by others.
# If THINKSPACE_PASSPHRASE is empty the app runs in OPEN mode (local development only) and shows a banner.
THINKSPACE_PASSPHRASE=
# 32+ random characters, used to sign the session cookie: openssl rand -hex 32
THINKSPACE_SECRET=

# ---- Intelligence (Anthropic Claude) ----
# LLM_PROVIDER: anthropic | mock   (defaults to anthropic when ANTHROPIC_API_KEY is set, else mock)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Cost/latency tuning. claude-opus-5-5 (default, $4/$20 per MTok) · claude-sonnet-5-5 ($2/$10) · claude-haiku-5-5 ($0.10/$0.50)
THINKSPACE_LLM_MODEL=claude-opus-5-5
THINKSPACE_SUMMARY_MODEL=claude-opus-5-5
THINKSPACE_LLM_EFFORT=low
THINKSPACE_SUMMARY_EFFORT=medium
THINKSPACE_CONTEXT_SEGMENTS=12

# ---- Visual scenes (Google Gemini image model) ----
# IMAGE_PROVIDER: gemini | mock   (defaults to gemini when GEMINI_API_KEY is set, else mock)
IMAGE_PROVIDER=
GEMINI_API_KEY=
THINKSPACE_IMAGE_MODEL=gemini-3.1-flash-image
THINKSPACE_MAX_IMAGES_PER_SESSION=12

# ---- Speech (runs in the browser; the server only mints short-lived tokens) ----
# SPEECH_PROVIDER default shown in the UI: browser | soniox | deepgram | mock
SPEECH_PROVIDER=browser
SONIOX_API_KEY=
DEEPGRAM_API_KEY=

# ---- Retention ----
# 0 keeps sessions until the user deletes them. N > 0 deletes sessions older than N days on startup.
THINKSPACE_RETENTION_DAYS=0
